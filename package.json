{
  "name": "petak",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint": "oxlint",
    "test": "vitest run tests/unit",
    "test:e2e": "node tests/e2e/features.mjs",
    "test:perf": "node tests/perf/perf50k.mjs",
    "licenses": "node scripts/gen-licenses.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@univerjs/core": "1.4.0",
    "@univerjs/data-validation": "^1.4.0",
    "@univerjs/design": "1.4.0",
    "@univerjs/docs": "1.4.0",
    "@univerjs/docs-ui": "1.4.0",
    "@univerjs/engine-formula": "1.4.0",
    "@univerjs/engine-render": "1.4.0",
    "@univerjs/find-replace": "1.4.0",
    "@univerjs/preset-sheets-conditional-formatting": "1.4.0",
    "@univerjs/preset-sheets-core": "1.4.0",
    "@univerjs/preset-sheets-data-validation": "^1.4.0",
    "@univerjs/preset-sheets-filter": "1.4.0",
    "@univerjs/preset-sheets-find-replace": "1.4.0",
    "@univerjs/preset-sheets-note": "^1.4.0",
    "@univerjs/preset-sheets-sort": "1.4.0",
    "@univerjs/preset-sheets-thread-comment": "^1.4.0",
    "@univerjs/sheets": "1.4.0",
    "@univerjs/sheets-conditional-formatting": "1.4.0",
    "@univerjs/sheets-conditional-formatting-ui": "1.4.0",
    "@univerjs/sheets-data-validation": "^1.4.0",
    "@univerjs/sheets-data-validation-ui": "^1.4.0",
    "@univerjs/sheets-filter": "1.4.0",
    "@univerjs/sheets-filter-ui": "1.4.0",
    "@univerjs/sheets-find-replace": "1.4.0",
    "@univerjs/sheets-formula": "1.4.0",
    "@univerjs/sheets-note": "^1.4.0",
    "@univerjs/sheets-note-ui": "^1.4.0",
    "@univerjs/sheets-numfmt": "1.4.0",
    "@univerjs/sheets-sort": "1.4.0",
