    "@univerjs/sheets-thread-comment": "^1.4.0",
    "@univerjs/sheets-thread-comment-ui": "^1.4.0",
    "@univerjs/sheets-ui": "1.4.0",
    "@univerjs/themes": "^1.4.0",
    "@univerjs/thread-comment": "^1.4.0",
    "@univerjs/thread-comment-ui": "^1.4.0",
    "@univerjs/ui": "1.4.0",
    "arquero": "^8.0.3",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "hyperformula": "^3.5.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
