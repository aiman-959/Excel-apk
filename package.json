    "oxlint": "^1.90.0",
    "playwright": "^1.63.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "description": "Petak — open-source spreadsheet for Android phones and tablets",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
